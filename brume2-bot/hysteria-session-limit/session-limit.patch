+package cmd
+
+import (
+	"github.com/apernet/hysteria/core/v2/server"
+	"github.com/stretchr/testify/require"
+	"testing"
+)
+
+func TestServerSessionLimitConfiguration(t *testing.T) {
+	for _, limit := range []int{0, 2, 10} {
+		c := serverConfig{MaxSessionsPerUser: limit, Auth: serverConfigAuth{Type: "password", Password: "test-only"}}
+		out := &server.Config{}
+		require.NoError(t, c.fillAuthenticator(out))
+		require.Equal(t, limit, out.MaxSessionsPerUser)
+	}
+	c := serverConfig{MaxSessionsPerUser: -1}
+	require.Error(t, c.fillAuthenticator(&server.Config{}))
+}

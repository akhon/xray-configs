+++ b/core/internal/integration_tests/session_limit_test.go
@@ -0,0 +1,207 @@
+package integration_tests
+
+import (
+	"context"
+	"crypto/tls"
+	"io"
+	"net"
+	"net/http"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/apernet/hysteria/core/v2/client"
+	"github.com/apernet/hysteria/core/v2/internal/protocol"
+	"github.com/apernet/hysteria/core/v2/server"
+	"github.com/apernet/quic-go"
+	"github.com/apernet/quic-go/http3"
+	"github.com/stretchr/testify/require"
+)
+
+type sessionTestAuth struct{}
+
+func (sessionTestAuth) Authenticate(_ net.Addr, value string, _ uint64) (bool, string) {
+	value = strings.ToLower(value)
+	return value == "alice" || value == "bob", value
+}
+
+func sessionTestServer(t *testing.T, limit int) net.Addr {
+	return sessionTestServerWithAuth(t, limit, sessionTestAuth{})
+}
+
+func sessionTestServerWithAuth(t *testing.T, limit int, auth server.Authenticator) net.Addr {
+	t.Helper()
+	conn, err := net.ListenPacket("udp", "127.0.0.1:0")
+	require.NoError(t, err)
+	s, err := server.NewServer(&server.Config{TLSConfig: serverTLSConfig(), Conn: conn,
+		Authenticator: auth, MaxSessionsPerUser: limit})
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = s.Close() })
+	go s.Serve()
+	return conn.LocalAddr()
+}
+
+func sessionTestHTTP(t *testing.T, addr net.Addr) (*quic.Conn, *http3.ClientConn) {
+	t.Helper()
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	conn, err := quic.DialAddr(ctx, addr.String(), &tls.Config{InsecureSkipVerify: true, NextProtos: []string{"h3"}}, nil)
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = conn.CloseWithError(0, "") })
+	transport := &http3.Transport{}
+	t.Cleanup(func() { _ = transport.Close() })
+	return conn, transport.NewClientConn(conn)
+}
+
+func sessionTestAuthRequest(value string) *http.Request {
+	req, _ := http.NewRequest(http.MethodPost, "https://"+protocol.URLHost+protocol.URLPath, nil)
+	protocol.AuthRequestToHeader(req.Header, protocol.AuthRequest{Auth: value})
+	return req
+}
+
+func TestSessionLimitRepeatedAuthReservesOnlyOnce(t *testing.T) {
+	addr := sessionTestServer(t, 2)
+	_, httpClient := sessionTestHTTP(t, addr)
+	for i := 0; i < 8; i++ {
+		resp, err := httpClient.RoundTrip(sessionTestAuthRequest("alice"))
+		require.NoError(t, err)
+		require.Equal(t, protocol.StatusAuthOK, resp.StatusCode)
+		resp.Body.Close()
+	}
+	second, err := sessionTestConnect(addr, "alice")
+	require.NoError(t, err)
+	defer second.Close()
+	_, err = sessionTestConnect(addr, "alice")
+	require.Error(t, err)
+}
+
+type sessionTestSlowAuth struct{ entered, resume chan struct{} }
+
+func (a sessionTestSlowAuth) Authenticate(_ net.Addr, value string, _ uint64) (bool, string) {
+	if value == "slow" {
+		close(a.entered)
+		<-a.resume
+	}
+	return true, "alice"
+}
+
+func TestSessionLimitDisconnectDuringAuthDoesNotLeak(t *testing.T) {
+	auth := sessionTestSlowAuth{make(chan struct{}), make(chan struct{})}
+	addr := sessionTestServerWithAuth(t, 2, auth)
+	conn, httpClient := sessionTestHTTP(t, addr)
+	done := make(chan error, 1)
+	go func() {
+		resp, err := httpClient.RoundTrip(sessionTestAuthRequest("slow"))
+		if resp != nil {
+			resp.Body.Close()
+		}
+		done <- err
+	}()
+	select {
+	case <-auth.entered:
+	case <-time.After(5 * time.Second):
+		t.Fatal("auth not entered")
+	}
+	require.NoError(t, conn.CloseWithError(0, ""))
+	close(auth.resume)
+	select {
+	case err := <-done:
+		require.Error(t, err)
+	case <-time.After(5 * time.Second):
+		t.Fatal("closed request did not finish")
+	}
+	var first client.Client
+	var err error
+	require.Eventually(t, func() bool { first, err = sessionTestConnect(addr, "alice"); return err == nil }, 5*time.Second, 20*time.Millisecond)
+	defer first.Close()
+	var second client.Client
+	require.Eventually(t, func() bool { second, err = sessionTestConnect(addr, "alice"); return err == nil }, 5*time.Second, 20*time.Millisecond)
+	defer second.Close()
+	_, err = sessionTestConnect(addr, "alice")
+	require.Error(t, err)
+}
+
+func sessionTestConnect(addr net.Addr, auth string) (client.Client, error) {
+	c, _, err := client.NewClient(&client.Config{ServerAddr: addr, Auth: auth,
+		TLSConfig: client.TLSConfig{InsecureSkipVerify: true}})
+	return c, err
+}
+
+func TestSessionLimitRealConnectionsAndRelease(t *testing.T) {
+	addr := sessionTestServer(t, 2)
+	first, err := sessionTestConnect(addr, "alice")
+	require.NoError(t, err)
+	defer first.Close()
+	second, err := sessionTestConnect(addr, "ALICE")
+	require.NoError(t, err)
+	defer second.Close()
+	_, err = sessionTestConnect(addr, "alice")
+	require.Error(t, err)
+	_, err = sessionTestConnect(addr, "wrong-password")
+	require.Error(t, err)
+	other, err := sessionTestConnect(addr, "bob")
+	require.NoError(t, err)
+	defer other.Close()
+	// Multiple proxy streams in one admitted client do not consume device slots.
+	echo, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+	e := &tcpEchoServer{Listener: echo}
+	defer e.Close()
+	go e.Serve()
+	for i := 0; i < 8; i++ {
+		stream, err := first.TCP(echo.Addr().String())
+		require.NoError(t, err)
+		require.NoError(t, stream.SetDeadline(time.Now().Add(5*time.Second)))
+		_, err = stream.Write([]byte("session still works"))
+		require.NoError(t, err)
+		got := make([]byte, len("session still works"))
+		_, err = io.ReadFull(stream, got)
+		require.NoError(t, err)
+		require.Equal(t, "session still works", string(got))
+		stream.Close()
+	}
+	first.Close()
+	var replacement client.Client
+	require.Eventually(t, func() bool { replacement, err = sessionTestConnect(addr, "alice"); return err == nil }, 5*time.Second, 50*time.Millisecond)
+	defer replacement.Close()
+	_, err = sessionTestConnect(addr, "alice")
+	require.Error(t, err)
+}
+
+func TestSessionLimitConcurrentRealHandshakes(t *testing.T) {
+	addr := sessionTestServer(t, 2)
+	var admitted atomic.Int64
+	var wg sync.WaitGroup
+	start := make(chan struct{})
+	successful := make(chan client.Client, 20)
+	for i := 0; i < 20; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			<-start
+			c, err := sessionTestConnect(addr, "alice")
+			if err == nil {
+				admitted.Add(1)
+				successful <- c
+			}
+		}()
+	}
+	close(start)
+	wg.Wait()
+	close(successful)
+	for c := range successful {
+		defer c.Close()
+	}
+	require.Equal(t, int64(2), admitted.Load())
+}
+
+func TestSessionLimitDisabledAllowsMoreThanTwo(t *testing.T) {
+	addr := sessionTestServer(t, 0)
+	for i := 0; i < 5; i++ {
+		c, err := sessionTestConnect(addr, "alice")
+		require.NoError(t, err)
+		defer c.Close()
+	}
+}

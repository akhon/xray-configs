@@ -0,0 +1,60 @@
+package server
+
+import (
+	"sync"
+	"sync/atomic"
+	"testing"
+)
+
+func TestSessionLimitConcurrentAdmission(t *testing.T) {
+	l := newSessionLimiter(2)
+	var accepted atomic.Int64
+	var wg sync.WaitGroup
+	start := make(chan struct{})
+	for i := 0; i < 200; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			<-start
+			if l.acquire("alice") {
+				accepted.Add(1)
+			}
+		}()
+	}
+	close(start)
+	wg.Wait()
+	if accepted.Load() != 2 {
+		t.Fatalf("accepted %d concurrent sessions", accepted.Load())
+	}
+	if !l.acquire("bob") || !l.acquire("bob") || l.acquire("bob") {
+		t.Fatal("accounts share a limit")
+	}
+	l.release("alice")
+	if !l.acquire("alice") || l.acquire("alice") {
+		t.Fatal("released slot was not reusable exactly once")
+	}
+	l.release("alice")
+	l.release("alice")
+	l.release("bob")
+	l.release("bob")
+	if len(l.active) != 0 {
+		t.Fatal("empty account counters were retained")
+	}
+}
+
+func TestSessionLimitZeroPreservesUnlimitedBehavior(t *testing.T) {
+	l := newSessionLimiter(0)
+	for i := 0; i < 100; i++ {
+		if !l.acquire("alice") {
+			t.Fatal("zero limit denied session")
+		}
+	}
+	l.release("alice")
+}
+
+func TestSessionLimitNegativeConfigurationRejected(t *testing.T) {
+	c := &Config{MaxSessionsPerUser: -1}
+	if err := c.fill(); err == nil {
+		t.Fatal("negative limit accepted")
+	}
+}

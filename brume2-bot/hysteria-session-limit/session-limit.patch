diff --git a/core/server/session_limit.go b/core/server/session_limit.go
new file mode 100644
index 0000000..784fcbc
--- /dev/null
+++ b/core/server/session_limit.go
@@ -0,0 +1,44 @@
+package server
+
+import "sync"
+
+// sessionLimiter owns only in-memory counts. Slots are reserved before auth
+// succeeds and released by the same connection's teardown, never by polling.
+type sessionLimiter struct {
+	mu     sync.Mutex
+	max    int
+	active map[string]int
+}
+
+func newSessionLimiter(max int) *sessionLimiter {
+	if max == 0 {
+		return nil
+	}
+	return &sessionLimiter{max: max, active: make(map[string]int)}
+}
+
+func (l *sessionLimiter) acquire(id string) bool {
+	if l == nil {
+		return true
+	}
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	if l.active[id] >= l.max {
+		return false
+	}
+	l.active[id]++
+	return true
+}
+
+func (l *sessionLimiter) release(id string) {
+	if l == nil {
+		return
+	}
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	if l.active[id] <= 1 {
+		delete(l.active, id)
+	} else {
+		l.active[id]--
+	}
+}

{
  "log": {
    "loglevel": "warning"
  },
  "inbounds": [
    {
      "tag": "vmess-tls-fixture",
      "listen": "0.0.0.0",
      "port": 443,
      "protocol": "vmess",
      "settings": {
        "clients": [
          {
            "id": "11111111-1111-4111-8111-111111111111",
            "security": "auto",
            "email": "vmess-fixture@example.invalid"
          }
        ]
      },
      "streamSettings": {
        "network": "tcp",
        "security": "tls",
        "tlsSettings": {
          "serverName": "example.com",
          "alpn": [
            "h2",
            "http/1.1"
          ],
          "certificates": [
            {
              "certificateFile": "/nonexistent/fixture/server.crt",
              "keyFile": "/nonexistent/fixture/server.key"
            }
          ]
        }
      }
    },
    {
      "tag": "vless-reality-fixture",
      "listen": "0.0.0.0",
      "port": 9443,
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "22222222-2222-4222-8222-222222222222",
            "flow": "xtls-rprx-vision",
            "email": "vless-fixture@example.invalid"
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "show": false,
          "dest": "example.com:443",
          "xver": 0,
          "serverNames": [
            "example.com"
          ],
          "privateKey": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
          "shortIds": [
            "0000000000000000"
          ]
        }
      }
    }
  ],
  "outbounds": [
    {
      "tag": "direct",
      "protocol": "freedom"
    },
    {
      "tag": "blocked",
      "protocol": "blackhole"
    }
  ]
}

{
  "listen": "0.0.0.0:443",
  "tls": {
    "cert": "/etc/hysteria2/server.crt",
    "key": "/etc/hysteria2/server.key"
  },
  "auth": {
    "type": "userpass",
    "userpass": {
      "alice": "REPLACE_WITH_ALICE_RANDOM_PASSWORD",
      "bob": "REPLACE_WITH_BOB_RANDOM_PASSWORD",
      "carol": "REPLACE_WITH_CAROL_RANDOM_PASSWORD"
    }
  },
  "trafficStats": {
    "listen": "127.0.0.1:18081",
    "secret": "REPLACE_WITH_LOCAL_STATS_API_SECRET"
  },
  "acl": {
    "inline": [
      "reject(0.0.0.0/8)",
      "reject(10.0.0.0/8)",
      "reject(100.64.0.0/10)",
      "reject(127.0.0.0/8)",
      "reject(169.254.0.0/16)",
      "reject(172.16.0.0/12)",
      "reject(192.168.0.0/16)",
      "reject(198.18.0.0/15)",
      "reject(224.0.0.0/4)",
      "reject(240.0.0.0/4)",
      "reject(::/128)",
      "reject(::1/128)",
      "reject(fc00::/7)",
      "reject(fe80::/10)",
      "reject(ff00::/8)",
      "reject(203.0.113.10/32)",
      "direct(all)"
    ]
  }
}

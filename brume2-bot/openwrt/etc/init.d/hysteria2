#!/bin/sh /etc/rc.common
START=96
STOP=10
USE_PROCD=1
start_service() {
    procd_open_instance
    procd_set_param command /usr/bin/hysteria server --config /etc/hysteria2/config.json --disable-update-check --log-level warn --log-format json
    procd_set_param respawn 3600 5 5
    procd_set_param file /etc/hysteria2/config.json /etc/hysteria2/server.crt /etc/hysteria2/server.key
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param limits core="0"
    procd_close_instance
}
